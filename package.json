{
  "name": "india-water-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "python -m unittest discover -s tests -v",
    "verify": "python tools/validate_starter.py && pnpm check && pnpm test && pnpm build",
    "refresh": "python pipeline/refresh.py",
    "export:journalists": "python tools/export_journalists.py",
    "package:site": "python tools/package_site.py"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "d3": "7.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/d3": "7.4.3",
    "@playwright/test": "1.63.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
