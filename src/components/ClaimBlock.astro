---
import { release, url } from '../lib/publication';
import type { Claim } from '../lib/publication';
const { claim, heading } = Astro.props as {claim: Claim; heading: string};
const sources = claim.evidenceIds.map(id => release.sources.find(s => s.id === id)).filter(Boolean);
---
<article class="claim-block"><p class="eyebrow">{claim.status} · reviewed {claim.reviewedAt?.slice(0,10) || 'date not recorded'}</p><h3>{heading}</h3><p>{claim.text}</p><div class="claim-sources"><strong>Evidence:</strong> {sources.map(s => s && <a href={url(`/sources/${s.id}/`)}>{s.publisher}, {s.publicationDate?.slice(0,10) || 'publication time unknown'} ↗</a>)}</div>{(claim.limitations || []).length > 0 && <details><summary>Limits of this finding</summary><ul>{(claim.limitations || []).map(limit => <li>{limit}</li>)}</ul></details>}<p class="small muted">Claim ID: {claim.id}</p></article>
