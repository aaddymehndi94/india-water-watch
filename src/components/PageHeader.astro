---
import Breadcrumbs from './Breadcrumbs.astro';
const { title, eyebrow, description, crumbs = [] } = Astro.props;
---
<Breadcrumbs items={crumbs.length ? crumbs : [{label:title}]} /><header class="page-header"><div class="shell"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lede">{description}</p></div></header>
