---
import { release, url } from '../lib/publication';
import { rainfallDepartureX as x } from '../lib/charts';
const { compact = false } = Astro.props;
const dated = release.observations.filter(o => o.metricId === 'rainfall_departure_pct' && typeof o.value === 'number' && Number.isFinite(o.value) && release.claims.some(c => c.id === o.claimId && ['verified','attributed','corrected'].includes(c.status)) && release.sources.some(s => s.id === o.sourceId));
const latestEnd = dated.reduce((end, row) => row.periodEnd > end ? row.periodEnd : end, '');
const approved = dated.filter(row => row.periodEnd === latestEnd);
const national = approved.find(o => o.geographyId === 'india');
const nationalClaim = national && release.claims.find(c => c.id === national.claimId);
const regions = approved.filter(o => o.geographyId !== 'india').sort((a,b) => a.geographyId.localeCompare(b.geographyId));
const names = new Map(release.geographies.map(g => [g.id, g.name]));
const samePeriod = regions.length > 1 && regions.every(o => o.periodStart === regions[0].periodStart && o.periodEnd === regions[0].periodEnd);
const inRange = regions.every(o => (o.value ?? 0) >= -50 && (o.value ?? 0) <= 10);
const canPlot = samePeriod && inRange;
const allSourceIds = [...new Set(approved.map(o => o.sourceId))];
const dateLabel = (iso: string) => new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${iso.slice(0,10)}T12:00:00Z`));
const nationalWindow = national ? `${dateLabel(national.periodStart)} to ${dateLabel(national.periodEnd)}` : '';
const regionalWindow = regions.length ? `${dateLabel(regions[0].periodStart)} to ${dateLabel(regions[0].periodEnd)}` : '';
const throughDate = national ? dateLabel(national.periodEnd) : regions.length ? dateLabel(regions[0].periodEnd) : '';
---
{approved.length > 0 && <section class:list={['rain-chart', {compact}]} aria-label="Rainfall departure evidence">
  <div class="section-head"><div><p class="eyebrow">Observed · attributed to IMD</p><h2>Rainfall through {throughDate}</h2></div><p>These are cumulative rainfall reports for the dates shown below. They do not measure stored water, groundwater or household service.</p></div>
  {national && <div class="national-finding"><div><p class="eyebrow">India · {nationalWindow}</p><strong>{(national.value as number).toFixed(1)}%</strong><span>reported departure from IMD's 1971–2020 normal</span></div><div><p>{nationalClaim?.text}</p><p class="small">Provider-displayed and rounded. <a href={url(`/sources/${national.sourceId}/`)}>National graphic and exact locator ↗</a></p></div></div>}
  {regions.length > 0 && <div class="regional-figure"><h3>Four broad IMD regions</h3><p class="small muted">IMD reports the regional percentages for the same dates. Its graphic does not print their separate cumulative normal totals, so these values have not been independently recomputed. They are shown as provider reports, not a ranked like-for-like comparison.</p>
    {canPlot ? <figure class="figure"><div class="chart-scroll" role="region" aria-label="Scrollable regional rainfall chart" tabindex="0"><svg viewBox={`0 0 760 ${110 + regions.length * 47}`} role="img" aria-labelledby="regional-chart-title regional-chart-desc"><title id="regional-chart-title">IMD reported regional rainfall departure, percent</title><desc id="regional-chart-desc">Four bars extend left of zero. They are attributed to IMD; regional cumulative normal totals were not available to replay them. Exact values and source links follow in a table.</desc><line x1="285" y1="42" x2="639" y2="42" stroke="#718984" /><line x1={x(0)} y1="42" x2={x(0)} y2={78 + regions.length * 47} stroke="#41585a" stroke-width="2" />{[-50,-25,0,10].map(tick => <g><line x1={x(tick)} y1="39" x2={x(tick)} y2="46" stroke="#718984"/><text x={x(tick)} y="28" text-anchor="middle" fill="#425b5d" font-size="13">{tick}%</text></g>)}{regions.map((o,i) => {const y=74+i*47;const v=o.value as number;return <g><text x="270" y={y+5} text-anchor="end" fill="#172d34" font-size="15">{names.get(o.geographyId) || o.geographyId}</text><rect x={Math.min(x(v),x(0))} y={y-12} width={Math.abs(x(v)-x(0))} height="25" fill="#8daea8"/><text x={x(v)-8} y={y+5} text-anchor="end" fill="#172d34" font-size="14" font-weight="700">{v.toFixed(1)}%</text></g>})}</svg></div><figcaption>Provider-reported percent departure, fixed axis −50% to +10%; period {regionalWindow}. Regional cumulative normal denominators were not printed in the graphic. <a href={url('/methodology/')}>Comparison method ↗</a></figcaption></figure> : <div class="empty-panel"><p>Regional rows have differing periods or values outside this chart's fixed axis. The table retains them without a shared visual scale.</p></div>}
    <div class="table-wrap"><table class="data-table regional-table"><caption class="sr-only">IMD regional rainfall departure observations with dates and exact sources</caption><thead><tr><th scope="col">IMD region</th><th scope="col">Reported departure</th><th scope="col">Period</th><th scope="col">Evidence</th></tr></thead><tbody>{regions.map(o => <tr><td>{names.get(o.geographyId) || o.geographyId}</td><td>{o.value}%</td><td>{o.periodStart.slice(0,10)} to {o.periodEnd.slice(0,10)}</td><td><a href={url(`/sources/${o.sourceId}/`)}>Source record ↗</a></td></tr>)}</tbody></table></div>
  </div>}
  <p class="small muted">Broad IMD homogeneous regions are not states, districts, basins or utility service areas. Their percentages cannot be assigned to a local place. Earlier approved snapshots remain in the observation CSV and individual source records.</p>
  <div class="button-row"><a class="button button-light" href={url('/downloads/observations.csv')} download>Download observation CSV</a><a class="button button-light" href={url('/downloads/rainfall-departure.svg')} download>Download chart SVG</a></div>
  <details class="source-drawer"><summary>Show chart source details</summary><div class="grid-2">{allSourceIds.map(id => {const s=release.sources.find(source => source.id === id);return s && <article><h3>{s.title}</h3><p class="small">{s.publisher} · observed through {s.observedThrough?.slice(0,10) || 'not recorded'} · published {s.publicationDate?.slice(0,10) || 'not recorded'} · retrieved {s.retrievedAt?.slice(0,10) || 'not recorded'}</p><p class="small"><strong>Locator:</strong> {s.locator}</p><a href={url(`/sources/${s.id}/`)}>Full evidence record ↗</a></article>})}</div></details>
</section>}
