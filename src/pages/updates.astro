---
import Site from '../layouts/Site.astro';
import PageHeader from '../components/PageHeader.astro';
import ClaimBlock from '../components/ClaimBlock.astro';
import { release, url } from '../lib/publication';
const entries = [
 ['C-IMD-RAINFALL-DEP-india-20260923','Rainfall observation through 23 September 2026'],
 ['C-IMD-OUTLOOK-20260831','IMD September forecast archive'],
 ['C-JJM-CONNECTIONS-20260303','Reported rural connection count'],
 ['C-JJM-FUNDS-20260331','Programme approval and reported release'],
] as const;
---
<Site title="Updates"><PageHeader title="Updates, with dates" eyebrow="Evidence desk" description="A curated list of reviewed source records. Observation, event, publication and review dates remain distinct." /><section class="section"><div class="shell reading"><p class="small muted">These are dated evidence entries, not a continuously refreshed news wire. A forecast valid for September 2026 is archived as a forecast, not carried forward as a current outlook. Repeated reports of one release are one source chain.</p>{entries.map(([id,heading]) => {const claim=release.claims.find(c => c.id === id);return claim && <ClaimBlock claim={claim} heading={heading} />})}<div class="note"><strong>What changed since a previous bulletin?</strong><p>No prior approved release with matching definitions has been bound to this snapshot, so a revision-versus-new-observation comparison is not yet available.</p></div><a href={url('/data-status/')}>See coverage and freshness ↗</a></div></section></Site>
