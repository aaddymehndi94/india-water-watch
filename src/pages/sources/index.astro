---
import Site from '../../layouts/Site.astro';
import PageHeader from '../../components/PageHeader.astro';
import SourceCatalogue from '../../components/SourceCatalogue';
import { discoverySources, publishedSources, url } from '../../lib/publication';
---
<Site title="Source catalogue"><PageHeader title="Follow the sources" eyebrow="Evidence desk" description="See which records support published findings and which are still research leads. Search by subject, agency or title, then inspect dates, locators and limitations." />
<section class="section"><div class="shell"><div class="atlas-coverage"><div class="atlas-kpi"><p class="eyebrow">Published evidence</p><strong>{publishedSources.length}</strong><p>Records linked to approved public claims or the official place roster.</p></div><div class="atlas-kpi"><p class="eyebrow">Discovery leads</p><strong>{discoverySources.length}</strong><p>Potential sources. Their contents are not automatically approved for findings.</p></div><div class="atlas-kpi"><p class="eyebrow">Check each date</p><strong>4</strong><p>Observation, publication, retrieval and review dates answer different questions.</p></div></div><p class="small muted">Source leads may change or become inaccessible. Their access notes were checked during research and must be rechecked before use.</p></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Search the record</p><h2>Source catalogue</h2></div><p>Published findings cite an exact evidence record. Browse a source page to see where it enters the story.</p></div><SourceCatalogue client:load approved={publishedSources} leads={discoverySources} base={url('/sources/')} /></div></section>
<section class="section"><div class="shell grid-2"><article class="editorial-card"><h3>How a source becomes evidence</h3><p>We save retrieval metadata, inspect a specific table or graphic, check its method and scope, and connect each supported claim to its locator.</p><a href={url('/methodology/')}>Read the method ↗</a></article><article class="editorial-card"><h3>What a link cannot prove</h3><p>A source homepage alone does not support every statement on this site. Changed PDFs, revisions and copied press releases require a new review.</p><a href={url('/journalists/')}>Journalist desk ↗</a></article></div></section></Site>
