---
import Site from '../../layouts/Site.astro';
import PageHeader from '../../components/PageHeader.astro';
import { discoverySources, publishedSources, url } from '../../lib/publication';
---
<Site title="Source catalogue"><PageHeader title="Source catalogue" eyebrow="Evidence desk" description="Approved evidence records and a separate discovery inventory. A useful source lead is not, by itself, support for a public finding." /><section class="section"><div class="shell"><h2>Approved source records</h2>{publishedSources.length ? <ul class="source-list">{publishedSources.map(s => <li><span class="tag">Approved evidence</span> <a href={url(`/sources/${s.id}/`)}>{s.title}</a><small>{s.publisher} · {s.publicationDate || 'publication date unavailable'} · locator {s.locator || 'not supplied'}</small></li>)}</ul> : <div class="empty-panel"><h3>No approved source records in this build</h3><p>The records below are leads for retrieval and review. They do not make the source's numerical contents publishable.</p></div>}</div></section><section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Research inventory</p><h2>Source leads</h2></div><p>Access status was checked during starter preparation. Current availability and rights may have changed.</p></div><ul class="source-list">{discoverySources.map(s => <li><span class="tag">{s.access_status?.replaceAll('_',' ')}</span> <a href={url(`/sources/${s.id}/`)}>{s.title}</a><small>{s.publisher} · last checked {s.checked_on || 'not checked'}</small></li>)}</ul></div></section></Site>
