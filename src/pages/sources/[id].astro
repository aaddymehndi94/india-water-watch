---
import Site from '../../layouts/Site.astro';
import PageHeader from '../../components/PageHeader.astro';
import { discoverySources, publishedSources, release, url } from '../../lib/publication';
export function getStaticPaths() { return [...discoverySources, ...publishedSources].map(s => ({params:{id:s.id},props:{source:s}})); }
const { source } = Astro.props;
const approved = publishedSources.some(s => s.id === source.id);
const uses = release.observations.filter(o => o.sourceId === source.id);
const claims = release.claims.filter(c => c.evidenceIds.includes(source.id));
const dateOnly = source.publicationDate && (source.publicationDate.length === 10 || ['E-IMD-OUTLOOK-20260831','E-NSO-WATER-2018'].includes(source.id));
const publicationDisplay = source.publicationDate ? (dateOnly ? `${source.publicationDate.slice(0,10)} (date only; time unknown)` : source.publicationDate) : 'Unknown or not recorded';
const observedThroughDisplay = source.observedThrough ? `${source.observedThrough.slice(0,10)} (calendar date only; clock time not specified)` : 'Not recorded';
---
<Site title={source.title}><PageHeader title={source.title} eyebrow={approved ? 'Approved evidence record' : 'Discovery source lead'} description={`${source.publisher}. ${approved ? 'A source included in the reviewed publication snapshot.' : 'This entry documents a research route; data from it has not been approved for public findings.'}`} crumbs={[{label:'Sources',href:'/sources/'},{label:source.title}]} /><section class="section"><div class="shell page-grid"><article><h2>Provenance</h2><div class="table-wrap"><table class="data-table"><tbody><tr><th scope="row">Publisher</th><td>{source.publisher}</td></tr><tr><th scope="row">Status</th><td>{approved ? 'Reviewed evidence in this release' : source.access_status?.replaceAll('_',' ') || 'Discovery only'}</td></tr><tr><th scope="row">Observation period ends</th><td>{observedThroughDisplay}</td></tr><tr><th scope="row">Provider publication date/time</th><td>{publicationDisplay}</td></tr><tr><th scope="row">Retrieved</th><td>{source.retrievedAt || source.checked_on || 'Not recorded'}</td></tr><tr><th scope="row">Exact locator</th><td>{source.locator || 'Not yet selected'}</td></tr><tr><th scope="row">Source SHA-256</th><td class="hash">{source.sha256 || 'Not recorded'}</td></tr><tr><th scope="row">Access and limits</th><td>{source.access_notes || 'See linked claims for applicable limits.'}</td></tr></tbody></table></div>
<h2>Claims supported by this evidence</h2>{claims.length ? <ul class="source-list">{claims.map(c => <li><span class="tag">{c.status}</span><p>{c.text}</p>{(c.limitations || []).length > 0 && <details><summary>Read limitations</summary><ul>{(c.limitations || []).map((limit:string) => <li>{limit}</li>)}</ul></details>}<small>Claim ID {c.id} · reviewed {c.reviewedAt || 'date not recorded'}</small></li>)}</ul> : <p>No approved public claim in this build cites this source.</p>}
<h2>Observation rows</h2>{uses.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th>Place ID</th><th>Indicator</th><th>Value</th><th>Observed period</th><th>Precision and cutoff</th></tr></thead><tbody>{uses.map(o => <tr><td>{o.geographyId}</td><td>{o.metricId.replaceAll('_',' ')}</td><td>{o.value === null ? 'Unavailable' : `${o.value} ${o.unit}`}</td><td>{o.periodStart.slice(0,10)} to {o.periodEnd.slice(0,10)}</td><td>{o.periodPrecision?.replaceAll('_',' ') || 'Date precision not recorded'}{o.cutoffConvention && <><br /><small>{o.cutoffConvention}</small></>}</td></tr>)}</tbody></table></div> : <p>No approved observation in this build cites this source.</p>}<p class="small muted">A link alone does not verify a value. Provider pages may change after the dated retrieval.</p></article><aside><p class="eyebrow">Source controls</p>{(source.url || source.entry_url) && <a href={source.url || source.entry_url || '#'} target="_blank" rel="noopener noreferrer">Open original source ↗</a>}<a href={url('/methodology/')}>How sources are checked</a><a href={url('/data-status/')}>Coverage and freshness</a><a href={url('/downloads/observations.csv')}>Download approved rows</a></aside></div></section></Site>
