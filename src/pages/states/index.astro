---
import Site from '../../layouts/Site.astro';
import PageHeader from '../../components/PageHeader.astro';
import { release, url } from '../../lib/publication';
const states = release.geographies.filter(g => ['state', 'union_territory', 'ut'].includes(g.type)).sort((a,b) => a.name.localeCompare(b.name));
---
<Site title="States and union territories"><PageHeader title="States & union territories" eyebrow="Location directory" description="Find a local briefing and see which indicators are actually available for that place." /><section class="section"><div class="shell"><p class="small muted">The 28-state and 8-union-territory name roster is from the <a href="https://www.india.gov.in/calendar?date=2026-09-24">National Portal of India</a> (page updated 23 September 2026). URL slugs are publication IDs, not official LGD codes; district joins await a versioned LGD export. This is a directory, not a ranking.</p>{states.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Place</th><th scope="col">Type</th><th scope="col">Approved observations</th></tr></thead><tbody>{states.map(g => <tr><td><a href={url(`/states/${g.slug}/`)}>{g.name}</a></td><td>{g.type === 'state' ? 'State' : 'Union territory'}</td><td>{release.observations.filter(o => o.geographyId === g.id).length}</td></tr>)}</tbody></table></div> : <div class="empty-panel"><h2>Directory awaiting a versioned official inventory</h2><p>The Local Government Directory is the intended source for current administrative codes and names. Until its export is reviewed, this site cannot safely present a complete list or local pages.</p><a href={url('/sources/lgd/')}>Inspect the LGD source lead ↗</a></div>}</div></section></Site>
