---
import Site from '../layouts/Site.astro';
import ClaimBlock from '../components/ClaimBlock.astro';
import PageHeader from '../components/PageHeader.astro';
import ResponseFlow, { type ResponseStage } from '../components/ResponseFlow';
import '../styles/g13-sidepages.css';
import '../styles/g14-documentary.css';
import { release, url } from '../lib/publication';
const claim = (id: string) => release.claims.find(c => c.id === id);
const karnataka = claim('C-KA-DROUGHT-ORDER-20260922');
const funds = claim('C-JJM-FUNDS-20260331');
const heavyRain = claim('C-IMD-WEATHER-EVENT-20260924');
const threeOrders = claim('C-KA-DROUGHT-THREE-ORDERS-20260922');
const floodAdvance = claim('C-MHA-FLOOD-ADVANCE-20260801');
const floodRescue = claim('C-MOD-FLOOD-RESCUE-20260726');
const interimRequest = claim('C-KA-INTERIM-REQUEST-20260923');
const assamFilters = claim('C-CSIR-ASSAM-FILTERS-20260810');
const nashikPhoto = claim('C-COMMONS-NASHIK-FLOOD-PHOTO-20260724');
const source = (id: string) => {
  const item = claim(id);
  return item ? url(`/sources/${item.evidenceIds[0]}/`) : url('/sources/');
};
const responseStages: [ResponseStage, ResponseStage, ResponseStage, ResponseStage, ResponseStage, ResponseStage] = [
  {id:'declaration',shortLabel:'Declaration',title:'The declaration is on paper.',status:'documented',dateLabel:'27 Aug–22 Sep 2026',headline:'177 distinct taluks in three gazettes.',detail:'The published annexes list 101, then 23, then 53 additional kharif drought-affected taluks. The latest order authorizes district relief under SDRF norms.',limit:'This is administrative scope, not a count of people, losses or aid delivered.',sources:[{label:'Three-order claim and annexes',href:threeOrders ? source(threeOrders.id) : url('/sources/'),claimId:threeOrders?.id}]},
  {id:'survey',shortLabel:'Survey directed',title:'Officials were told to measure loss.',status:'directed',dateLabel:'22 Sep 2026',headline:'A joint crop-loss survey is directed.',detail:'The latest Karnataka order directs a joint survey and authorizes district authorities to undertake relief under SDRF norms.',limit:'A directed survey is not a completed survey or a measured crop-loss result.',sources:[{label:'22 September gazette',href:karnataka ? source(karnataka.id) : url('/sources/'),claimId:karnataka?.id}]},
  {id:'request',shortLabel:'Interim request',title:'The state asked for central assistance.',status:'documented',dateLabel:'23 Sep 2026',headline:'₹1,852.65 crore requested as interim help.',detail:'Chief Minister D.K. Shivakumar requested half of the ₹3,705.30 crore that his letter says Karnataka had sought for its first 101 declared taluks, plus advance release of the Centre’s second SDRF instalment.',limit:'The earlier memorandum was not independently retrieved. This letter proves a request, not central approval or payment.',sources:[{label:'Signed letter and arithmetic',href:interimRequest ? source(interimRequest.id) : url('/sources/'),claimId:interimRequest?.id}]},
  {id:'transfer',shortLabel:'Transfer',title:'Follow the money, not the announcement.',status:'not-verified',dateLabel:'No approved record here',headline:'No central approval or transfer verified in this release.',detail:'The published letter asks for assessment and interim assistance. A later approval order and transaction record would be needed to establish a transfer.',limit:'A missing record in this publication is not evidence that authorities denied, withheld or failed to pay assistance.',sources:[{label:'Original request and limits',href:interimRequest ? source(interimRequest.id) : url('/sources/'),claimId:interimRequest?.id}]},
  {id:'delivery',shortLabel:'Local delivery',title:'Then ask what reached each place.',status:'not-verified',dateLabel:'No approved record here',headline:'District spending and household receipt remain open.',detail:'A district order, spending ledger, distribution list and dated local reporting could establish what was delivered to which taluks.',limit:'Neither a declaration nor a state-to-Union request documents beneficiary receipt.',sources:[{label:'Declaration scope',href:threeOrders ? source(threeOrders.id) : url('/sources/'),claimId:threeOrders?.id}]},
  {id:'outcome',shortLabel:'Outcome',title:'The result must be observed.',status:'not-verified',dateLabel:'No approved record here',headline:'Loss, service and recovery need their own measures.',detail:'Completed crop surveys, utility records and household experience would show whether conditions changed and for whom.',limit:'Do not infer losses, safe supply or recovery from the existence of an order, request or rainy day.',sources:[{label:'22 September order and limits',href:karnataka ? source(karnataka.id) : url('/sources/'),claimId:karnataka?.id}]},
];
---
<Site title="An order is the first step" description="The 22 September Karnataka declaration, the documented Jal Jeevan Mission programme step and the records needed to establish relief outcomes.">
  <PageHeader title="An order is the first step" eyebrow="Government response / documented stages" description="A declaration changes an administrative status. The next questions are whether relief was funded, delivered, and felt by the people it was meant to reach." />
  <section class="section g11-chapter"><div class="shell"><div class="g11-chapter-head"><span class="g11-chapter-number">01</span><div><p class="eyebrow">Karnataka / three gazettes / through 22 September 2026</p><h2>One hundred and seventy-seven taluks are listed.</h2></div></div>
    {threeOrders && <div class="grid-2"><div class="g11-signal"><span class="g11-tag order">Government orders · administrative count</span><strong>177</strong><p>distinct drought-affected taluks across the 27 August, 17 September and 22 September kharif 2026 gazettes: 161 severe and 16 moderate. This is not a count of people, measured crop loss or relief delivered.</p><p class="small"><a href={url('/sources/E-KA-GAZETTE-DROUGHT-20260827/')}>27 Aug ↗</a> · <a href={url('/sources/E-KA-GAZETTE-DROUGHT-20260917/')}>17 Sep ↗</a> · <a href={url('/sources/E-KA-GAZETTE-DROUGHT-20260922/')}>22 Sep ↗</a></p></div><div class="g11-clock"><p class="eyebrow">How the list grew</p><p>The original annexes list 101, then 23, then 53 additional taluks; checked district–taluk pairs did not overlap. The latest <a href={karnataka ? source(karnataka.id) : url('/sources/')}>22 September order</a> takes effect immediately for up to six months unless revoked, authorizes district relief under SDRF norms and directs a joint crop-loss survey.</p><p><strong>What remains open:</strong> aid delivered, survey results and household supply. The 17 September gazette has a preamble inconsistency; its operative annex supports 21 severe and two moderate taluks. <a href={url('/sources/E-KA-GAZETTE-DROUGHT-20260917/')}>Inspect that source ↗</a></p></div></div>}
    {heavyRain && <aside class="g11-clock"><span class="g11-tag measured">Observed event · IMD reported</span><h3>A heavy-rain event does not finish this story.</h3><p>IMD reported very heavy rain in coastal and south-interior Karnataka during the 24 hours ending 08:30 IST on 24 September. That report is a later local weather event; it neither measures crop recovery nor documents relief delivery under the 22 September order. <a href={source(heavyRain.id)}>Weather release ↗</a> <a href={karnataka ? source(karnataka.id) : url('/sources/')}>Gazette order ↗</a></p></aside>}
    {interimRequest && <aside class="g14-request"><span class="g11-tag order">Chief minister's signed request · 23 September</span><strong>₹1,852.65 crore</strong><div><h3>Requested as interim assistance. Delivery is a separate question.</h3><p>D.K. Shivakumar asked the Prime Minister for half of an earlier ₹3,705.30 crore memorandum amount described in his letter, plus advance release of a central SDRF instalment. The letter does not show approval, transfer or aid reaching households. <a href={source(interimRequest.id)}>Read the original request and arithmetic ↗</a></p></div></aside>}
    <p class="g11-pull">The declaration is real. The outcome is an open question.</p>
  </div></section>
  {floodAdvance && floodRescue && <section class="section g11-chapter"><div class="shell"><div class="g11-chapter-head"><span class="g11-chapter-number">02</span><div><p class="eyebrow">A separate branch / flood response / July–August 2026</p><h2>The same monsoon produced another kind of official action.</h2></div></div><p class="g11-pull">The national water story cannot be drawn as drought in every place. Flood operations and funding approvals have different dates, geographies and evidentiary stages.</p><div class="g13-response-branches"><article><span class="g11-tag order">Agency-reported operation · 26 July</span><strong>&gt;790</strong><p>The Indian Army said it evacuated more than 790 people since 23 July in parts of Gujarat and Dadra & Nagar Haveli and distributed drinking water and essentials. This is an agency-reported output, not a national rescue total or long-term recovery result.</p><a href={source(floodRescue.id)}>Ministry of Defence release and limits ↗</a></article><article><span class="g11-tag order">Union approval · 1 August</span><strong>₹2,117.85 crore</strong><p>The Union government said it approved advance central SDRF shares for six flood-affected states. This release does not verify transfer of those new advances or household delivery. It is not Karnataka drought aid.</p><a href={source(floodAdvance.id)}>Ministry of Home Affairs release and limits ↗</a></article></div>{assamFilters && <aside class="g14-assam"><span class="g11-tag order">Agency-reported implementation · Assam · 10 August</span><div><strong>10 <small>installed</small></strong><strong>90 <small>handed over</small></strong></div><p>After flooding in Jorhat district, CSIR-NEERI reported installing ten emergency water-treatment units in one village and handing another 90 to district officials. That is deployment and handover, not independently tested water quality or lasting household service. <a href={source(assamFilters.id)}>Agency release and limits ↗</a></p></aside>}<p class="small muted">The July rescue and August approval concern different actions and places; neither is synchronized with the 24 September rainfall graphic. No amount or person count is added across these records.</p></div></section>}
  {nashikPhoto && <section class="g14-documentary" id="flood-photo" aria-labelledby="g14-documentary-title"><div class="shell"><div class="g14-documentary-heading"><p class="eyebrow">Documentary photograph / another part of the monsoon</p><h2 id="g14-documentary-title">A river over its banks.<br /><em>A different water emergency.</em></h2><p>This photograph records a July flood scene in Nashik. It does not picture September drought or explain the national rainfall number.</p></div><figure><img src={url('/images/nashik-godavari-20260724-1280.jpg')} width="1280" height="960" loading="lazy" decoding="async" alt="Brown floodwater covers the Ramkund ghats beside buildings and a temple on the Godavari in Nashik." /><figcaption><strong>Godavari at Ramkund, Nashik · 24 July 2026.</strong> <a href={source(nashikPhoto.id)}>Scene evidence ↗</a><br />“Nashik Rains Godavari Floods Ramkund Panchavati 24 July 2026 Images 4.jpg”, © 2026 Rohit R Nashik / Temple City Nashik, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> via <a href="https://commons.wikimedia.org/wiki/File:Nashik_Rains_Godavari_Floods_Ramkund_Panchavati_24_July_2026_Images_4.jpg">Wikimedia Commons</a>; resized from original, no crop or colour alteration. The license and change notice are also bundled beside the image in the portable site.</figcaption></figure></div></section>}
  <section class="section g11-chapter"><div class="shell"><div class="g11-chapter-head"><span class="g11-chapter-number">03</span><div><p class="eyebrow">How a decision becomes a result</p><h2>Follow the paper trail, stage by stage.</h2></div></div>
    <ResponseFlow client:load reviewedAsOf="24 September 2026" scopeLabel="Karnataka / kharif 2026" headline="Three actions on record. Outcomes open." introduction="Open a checkpoint to see the original order, the later central-assistance request, and the records still needed to establish payment and outcomes. A request is not a transfer." stages={responseStages} />
  </div></section>
  <section class="section g11-chapter"><div class="shell"><div class="g11-chapter-head"><span class="g11-chapter-number">04</span><div><p class="eyebrow">A separate national programme</p><h2>Jal Jeevan Mission is another record—not the Karnataka relief order.</h2></div></div>
    {funds && <div class="grid-2"><div><span class="g11-tag order">Ministry report</span><p>On 31 March 2026 the Ministry of Jal Shakti said the Union Cabinet had approved Jal Jeevan Mission 2.0 on 10 March and operational guidelines had been released on 22 March. It reported <strong>₹1,561.53 crore released to five named states</strong> for FY 2025–26. <a href={source(funds.id)}>Ministry release ↗</a></p></div><div class="g11-clock"><p class="eyebrow">Do not skip a stage</p><p>This is the ministry's account of an approval, guidelines and fund release. It is not independent treasury confirmation, state expenditure, completed work or proof of better service. It is not identified as a response to the September rainfall shortfall.</p></div></div>}
    <div class="g11-epilogue"><p class="eyebrow">A reporting path</p><h3>Which record would answer the next question?</h3><p>For Karnataka, seek the joint survey, relief orders, transfer records and district delivery evidence. For a tap-water scheme, seek the completion record and measured reliability and quality. Absence from our approved ledger is not evidence that an authority did nothing.</p><a href={url('/journalists/')}>Use the document question bank ↗</a></div>
  </div></section>
  <section class="section"><div class="shell reading"><p class="eyebrow">Exact source-linked findings</p>{threeOrders && <ClaimBlock claim={threeOrders} heading="Three Karnataka orders: 177 listed taluks" />}{karnataka && <ClaimBlock claim={karnataka} heading="22 September order: 53 additional taluks" />}{interimRequest && <ClaimBlock claim={interimRequest} heading="23 September interim assistance request" />}{floodRescue && <ClaimBlock claim={floodRescue} heading="Army-reported July flood operation" />}{floodAdvance && <ClaimBlock claim={floodAdvance} heading="August flood funding approval" />}{assamFilters && <ClaimBlock claim={assamFilters} heading="Assam treatment-unit deployment and handover" />}{nashikPhoto && <ClaimBlock claim={nashikPhoto} heading="Licensed Nashik flood photograph" />}{funds && <ClaimBlock claim={funds} heading="Ministry-reported JJM 2.0 step" />}</div></section>
</Site>
