---
import Site from '../../layouts/Site.astro';
import PageHeader from '../../components/PageHeader.astro';
import AtlasFilter from '../../components/AtlasFilter';
import Status from '../../components/Status.astro';
import RainfallChart from '../../components/RainfallChart.astro';
import { release, url } from '../../lib/publication';
const visible = release.observations.filter(o => Number.isFinite(o.value) && release.sources.some(s => s.id === o.sourceId) && release.claims.some(c => c.id === o.claimId && ['verified','attributed','corrected'].includes(c.status)));
const local = release.geographies.filter(g => ['state','union_territory','ut'].includes(g.type));
const latestRainfall = visible.filter(o => o.metricId === 'rainfall_departure_pct').reduce((latest, row) => row.periodEnd > latest ? row.periodEnd : latest, '');
---
<Site title="Explore the evidence"><PageHeader title="Explore what we know" eyebrow="Evidence atlas" description={`${visible.length} approved observations; ${local.length} state and union territory coverage records. Select a place to see what is measured, what is still unknown, and the original evidence.`} />
<section class="section"><div class="shell"><Status compact /><div class="atlas-coverage" aria-label="Snapshot coverage"><div class="atlas-kpi"><p class="eyebrow">Measured rainfall</p><strong>{visible.filter(o => o.metricId === 'rainfall_departure_pct').length}</strong><p>India and broad IMD regions. Latest approved observation ends {latestRainfall || 'on an unrecorded date'}.</p></div><div class="atlas-kpi"><p class="eyebrow">Monitored storage</p><strong>{visible.filter(o => o.metricId === 'reservoir_live_storage_bcm').length}</strong><p>CWC reservoir cohorts, with their own status date and source. Not a basin or local supply value.</p></div><div class="atlas-kpi"><p class="eyebrow">Local directory</p><strong>{local.length}</strong><p>State and UT records. {local.filter(g => visible.some(o => o.geographyId === g.id)).length} have approved local numeric observations.</p></div></div><p class="small muted">Counts describe this publication’s reviewed coverage, not national monitoring coverage. District, basin flow, groundwater and household service layers remain unmeasured here. No map shading is shown without a licensed geometry and matching measurements.</p></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Investigate</p><h2>The evidence workbench</h2></div><p>Choose measured data or look up a local coverage record. Filters change the URL so a view can be shared.</p></div><AtlasFilter client:load geographies={release.geographies} observations={visible} sourceBase={url('/sources/')} stateBase={url('/states/')} /></div></section>
<section class="section"><div class="shell"><RainfallChart compact /></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">What the map cannot say yet</p><h2>Follow the geography</h2></div><p>Administrative, meteorological and catchment boundaries answer different questions.</p></div><div class="grid-3"><article class="editorial-card"><h3><a class="title-link" href={url('/states/')}>States & UTs ↗</a></h3><p>Find an official roster entry and the exact local coverage status. Regional IMD values are never copied into a state.</p></article><article class="editorial-card"><h3><a class="title-link" href={url('/districts/')}>District evidence ↗</a></h3><p>See why matching administrative codes, dates and source footprints is required before localizing a number.</p></article><article class="editorial-card"><h3><a class="title-link" href={url('/basins/')}>Basins & flows ↗</a></h3><p>Trace how a watershed, storage system and service network would be checked, without inventing a flow map.</p></article></div></div></section></Site>
