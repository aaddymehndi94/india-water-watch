---
import Site from '../layouts/Site.astro';
import PageHeader from '../components/PageHeader.astro';
import { release, url } from '../lib/publication';
// @ts-ignore Node built-ins are available during Astro's build; root toolchain owns @types/node.
import { readFileSync, existsSync } from 'node:fs';
const tasks = JSON.parse(readFileSync('project/tasks.json','utf8')) as {id:string;title:string;status:string;gate:string}[];
const state = JSON.parse(readFileSync('state/PROJECT_STATE.json','utf8')) as {phase:string;current_gate:string;software_ready:boolean;editorially_ready:boolean;deployed:boolean};
const testPath = 'state/TEST_STATUS.json';
const tests = existsSync(testPath) ? JSON.parse(readFileSync(testPath,'utf8')) as {label:string;status:string;at?:string}[] : [];
const gates = [...new Set(tasks.map(t => t.gate))];
const builtAt = new Date().toISOString();
---
<Site title="Build progress"><PageHeader title="Build progress" eyebrow="Project log" description="A snapshot of recorded tasks and checks at the time this site was built. It is not a live water observation feed." /><section class="section"><div class="shell"><div class="grid-3"><div class="empty-panel"><p class="eyebrow">Build status</p><h3>{state.software_ready ? 'Software candidate ready' : 'In development'}</h3><p>Recorded phase: {state.phase.replaceAll('_',' ')} · gate {state.current_gate}</p></div><div class="empty-panel"><p class="eyebrow">Editorial status</p><h3>{state.editorially_ready ? 'Editorial review complete' : 'Review in progress'}</h3><p>Public findings still require claim-by-claim source review.</p></div><div class="empty-panel"><p class="eyebrow">Deployment status</p><h3>{state.deployed ? 'Recorded as deployed' : 'Deployment not yet recorded in this build'}</h3><p>Last site build: <time datetime={builtAt}>{builtAt}</time>. This is not a data date.</p></div></div><div class="note" style="margin-top:2rem"><strong>Water data are tracked separately.</strong><p>{release.observations.length} approved observations are in this build. Their periods belong to the observation rows. <a href={url('/data-status/')}>Inspect freshness and gaps.</a></p></div><h2 style="margin-top:3rem">Task record</h2><p>These statuses come from the project's task file at build time. They describe work completed, not percentages of India covered.</p>{gates.map(gate => <section aria-label={`Gate ${gate}`}><h3>{gate}</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>ID</th><th>Task</th><th>Recorded status</th></tr></thead><tbody>{tasks.filter(t => t.gate === gate).map(t => <tr><td>{t.id}</td><td>{t.title}</td><td>{t.status.replaceAll('_',' ')}</td></tr>)}</tbody></table></div></section>)}<h2 style="margin-top:3rem">Recorded checks</h2>{tests.length ? <ul class="source-list">{tests.map(t => <li><strong>{t.label}</strong><small>{t.status} · {t.at || 'time not recorded'}</small></li>)}</ul> : <p>No check record was supplied to the public progress page. This does not mean checks passed.</p>}</div></section></Site>
