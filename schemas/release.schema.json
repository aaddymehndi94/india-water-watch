{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "git_commit": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "root",
        "github",
        "compact"
      ]
    },
    "base_path": {
      "type": "string",
      "minLength": 1
    },
    "source_watermarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "observation_through": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "current",
              "stale",
              "unknown"
            ]
          }
        },
        "required": [
          "source_id",
          "observation_through",
          "retrieved_at",
          "status"
        ]
      }
    },
    "published_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "published_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "review_report_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "release_id",
    "built_at",
    "git_commit",
    "snapshot_sha256",
    "schema_version",
    "profile",
    "base_path",
    "source_watermarks",
    "published_claim_ids",
    "published_observation_ids",
    "scope_note",
    "limitations",
    "files_sha256",
    "review_report_path"
  ]
}
